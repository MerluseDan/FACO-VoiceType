{
  "module_id": "faco.voicetype",
  "name": "FACO VoiceType",
  "version": "1.2.1",
  "module_type": "desktop_daemon",
  "entrypoint": "/media/owner/Faco Resources1/FACO/apps/voicetype/run.sh",
  "installer": "install.sh",
  "standalone": true,
  "autostart": true,
  "requires_user_test_declaration": true,
  "canonical_paths": {
    "app": "/media/owner/Faco Resources1/FACO/apps/voicetype",
    "state": "/media/owner/Faco Resources1/_state/apps/voicetype",
    "data": "/media/owner/Faco Resources1/_data/apps/voicetype",
    "runtime": "/media/owner/Faco Resources1/_shared/environments/faco-voicetype",
    "models": "/media/owner/Faco Resources1/_shared/models/faster-whisper",
    "logs": "~/Desktop/Logs/FACO VoiceType"
  },
  "capabilities": [
    "global_mouse_trigger",
    "multi_mouse_action_mapping",
    "mouse_enter_submit",
    "speech_to_text",
    "expressive_punctuation",
    "focused_text_injection",
    "tray_control",
    "cuda_optional",
    "system_pulse",
    "canonical_state",
    "shared_resource_reuse"
  ],
  "platforms": ["linux"],
  "desktop_sessions": ["wayland", "x11"]
}
